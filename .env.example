# Core settings
# Local example values are shown below. Replace them on the production server.
DATABASE_URL=postgresql://boldtrip:boldtrip@localhost:5432/boldtrip
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEPLOYMENT_MODE=production

# Simple production baseline
# On the live server use:
# NEXT_PUBLIC_SITE_URL=https://boldtrip.ir
# Configure private S3 and ClamAV before accepting real document uploads.
# Keep enabled staff MFA enabled.
STORAGE_MODE=local
BOOKING_HOLD_MINUTES=60

# Database schema changes are explicit. Never enable schema push against production.
PAYLOAD_DB_PUSH=false

# Optional security/infrastructure upgrades.
# Leave blank unless the feature is configured.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

CLAMD_HOST=
CLAMD_PORT=3310

RESEND_API_KEY=
EMAIL_FROM=

STAFF_MFA_REQUIRED=false
STAFF_MFA_ENCRYPTION_KEY=
